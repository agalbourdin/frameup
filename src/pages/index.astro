---
import { readdir } from "node:fs/promises";
import { resolve } from "node:path";
import "../styles/globals.css";

const presetDirectory = resolve(process.cwd(), "public/preset-backgrounds");
const supportedImage = /\.(avif|gif|jpe?g|png|webp)$/i;
const siteUrl = import.meta.env.SITE;
const publicPageUrl = siteUrl ? new URL(siteUrl.endsWith("/") ? siteUrl : `${siteUrl}/`).toString() : undefined;
const openGraphImage = publicPageUrl ? new URL("og.jpg", publicPageUrl).toString() : undefined;
const title = "Free Online Screenshot Composer for Social Media | FrameUp";
const description = "Create polished, share-ready screenshots in your browser. FrameUp is free, private, open source, and requires no sign-up.";
const openGraphImageAlt = "FrameUp's screenshot composer interface";
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "FrameUp",
  description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any",
  isAccessibleForFree: true,
  ...(publicPageUrl ? { url: publicPageUrl } : {}),
});
const presetBackgrounds = (await readdir(presetDirectory))
  .filter((filename) => supportedImage.test(filename))
  .sort((left, right) => left.localeCompare(right))
  .map((filename) => ({
    src: `./preset-backgrounds/${filename}`,
    previewSrc: `./preset-backgrounds/preview/${filename}`,
    name: filename.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " "),
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {publicPageUrl && <link rel="canonical" href={publicPageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FrameUp" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {publicPageUrl && <meta property="og:url" content={publicPageUrl} />}
    {openGraphImage && <meta property="og:image" content={openGraphImage} />}
    {openGraphImage && <meta property="og:image:width" content="1200" />}
    {openGraphImage && <meta property="og:image:height" content="630" />}
    {openGraphImage && <meta property="og:image:type" content="image/jpeg" />}
    {openGraphImage && <meta property="og:image:alt" content={openGraphImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {openGraphImage && <meta name="twitter:image" content={openGraphImage} />}
    {openGraphImage && <meta name="twitter:image:alt" content={openGraphImageAlt} />}
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <link rel="icon" href="./favicon.ico" />
    <link rel="icon" href="./favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="./favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;200;300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
        <section class="hero" aria-labelledby="page-title"><h1 id="page-title">FrameUp</h1><p class="intro">FrameUp transforms raw screenshots into polished, share-ready visuals in seconds. Free, open source, private by design, and no sign-up required.</p></section>
      <section class="workspace" aria-label="Visual creation">
        <div class="controls">
          <div class="background-source" aria-label="Background image source">
            <button type="button" class="active" data-background-mode="presets">Preset BG</button>
            <button type="button" data-background-mode="upload">Upload BG</button>
            <button type="button" data-background-mode="color">Color BG</button>
          </div>
          <div class="background-panel" data-background-panel="presets"><div class="preset-grid" aria-label="Preset background images">
            {presetBackgrounds.map((preset, index) => <button type="button" class:list={["preset-card", { selected: index === 0 }]} data-preset-src={preset.src} data-preset-name={preset.name} aria-pressed={index === 0 ? "true" : "false"} aria-label={`Choose background ${preset.name}`}><img src={preset.previewSrc} alt="" width="110" height="82" loading="lazy" decoding="async" /></button>)}
          </div><a class="preset-backgrounds-link" href="https://www.color4bg.com" target="_blank" rel="noopener noreferrer">Create your own background on color4bg.com <svg class="external-link-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 2h5v5M14 2 7 9M14 9v3a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h3" /></svg></a></div>
          <div class="background-panel" data-background-panel="upload" hidden><label class="upload-card"><input id="background-upload" type="file" accept="image/png,image/jpeg,image/webp" /><span class="upload-icon" aria-hidden="true">✦</span><span class="upload-copy"><strong>Background image</strong><small id="background-file-name">PNG, JPEG, or WebP</small></span><span class="upload-action">Choose or drop</span></label></div>
          <div class="background-panel" data-background-panel="color" hidden><fieldset class="color-background-control"><legend>Color background</legend><div class="color-style-options" aria-label="Color background style"><label><input type="radio" name="gradient-style" value="solid" checked /><span>Solid</span></label><label><input type="radio" name="gradient-style" value="horizontal" /><span>Horizontal</span></label><label><input type="radio" name="gradient-style" value="vertical" /><span>Vertical</span></label><label><input type="radio" name="gradient-style" value="radial" /><span>Radial</span></label></div><div class="color-pickers"><label><span id="primary-color-label">Color</span><input id="primary-color" type="color" value="#9b5de5" /><output id="primary-color-value">#9B5DE5</output></label><label id="secondary-color-control" hidden><span>Second color</span><input id="secondary-color" type="color" value="#f15bb5" /><output id="secondary-color-value">#F15BB5</output></label></div></fieldset></div>
          <label class="upload-card"><input id="screenshot-upload" type="file" accept="image/png,image/jpeg,image/webp" /><span class="upload-icon" aria-hidden="true">▣</span><span class="upload-copy"><strong>Screenshot</strong><small id="screenshot-file-name">PNG, JPEG, or WebP</small></span><span class="upload-action">Choose or drop</span></label>
          <label class="shadow-option" id="background-blur-option" hidden><input id="background-blur-toggle" type="checkbox" /><span>Blur background</span></label>
          <label class="shadow-option"><input id="shadow-toggle" type="checkbox" checked /><span>Add a shadow to the screenshot</span></label>
          <fieldset class="radius-control"><legend>Corner radius</legend><div class="radius-options"><label title="No rounding"><input type="radio" name="corner-radius" value="0" aria-label="No rounding" /><span><svg aria-hidden="true" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17V3h16" /></svg></span></label><label title="Slightly rounded corners"><input type="radio" name="corner-radius" value="16" aria-label="Slightly rounded corners" /><span><svg aria-hidden="true" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17V8a5 5 0 0 1 5-5h11" /></svg></span></label><label title="Very rounded corners"><input type="radio" name="corner-radius" value="32" checked aria-label="Very rounded corners" /><span><svg aria-hidden="true" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17v-4C4 7.5 8.5 3 14 3h6" /></svg></span></label></div></fieldset>
          <fieldset class="radius-control"><legend>Screenshot padding</legend><div class="radius-options"><label title="25 px padding"><input type="radio" name="screenshot-padding" value="25" checked aria-label="25 px padding" /><span><svg aria-hidden="true" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.75" y="2.75" width="26.5" height="14.5" rx="1.5"/><rect x="6" y="5.25" width="20" height="9.5" rx=".75"/></svg></span></label><label title="50 px padding"><input type="radio" name="screenshot-padding" value="50" aria-label="50 px padding" /><span><svg aria-hidden="true" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.75" y="2.75" width="26.5" height="14.5" rx="1.5"/><rect x="8.5" y="6.75" width="15" height="6.5" rx=".75"/></svg></span></label><label title="75 px padding"><input type="radio" name="screenshot-padding" value="75" aria-label="75 px padding" /><span><svg aria-hidden="true" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.75" y="2.75" width="26.5" height="14.5" rx="1.5"/><rect x="11" y="8" width="10" height="4" rx=".75"/></svg></span></label></div></fieldset>
          <p class="status" id="status" aria-live="polite">Reading image…</p>
        </div>
        <div class="preview-panel"><div class="preview-topline"><span>PREVIEW</span><span>2400 × 1260 PX</span></div><div class="canvas-wrap" id="canvas-wrap"><p>Your visual will appear here</p><canvas id="preview-canvas" aria-label="Preview of your composed visual"></canvas></div><div class="download-actions"><button class="download-button" id="download-button" type="button" disabled>Download PNG <span aria-hidden="true">↓</span></button><button class="download-button twitter-download-button" id="twitter-download-button" type="button" disabled>Download OG / Twitter Image JPEG (1200 × 630) <span aria-hidden="true">↓</span></button></div></div>
      </section>
      <section class="reassurance" aria-labelledby="reassurance-title">
        <div class="reassurance-heading"><h2 id="reassurance-title">PRIVATE BY DESIGN</h2></div>
        <div class="reassurance-grid">
          <article class="reassurance-card"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 4.5 6.5V12c0 4.6 3.2 7.8 7.5 9 4.3-1.2 7.5-4.4 7.5-9V6.5L12 3Z"/><path d="m9.5 12 1.7 1.7 3.6-3.6"/></svg><div><h3>Privacy First</h3><p>Your screenshots never leave your browser. Everything runs locally.</p></div></article>
          <article class="reassurance-card"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3"/><path d="M6.5 19a5.5 5.5 0 0 1 11 0"/></svg><div><h3>No Sign-Up</h3><p>Open the app, drop your screenshot, and export in seconds.</p></div></article>
          <article class="reassurance-card"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m8 9-3 3 3 3M16 9l3 3-3 3M14 5l-4 14"/></svg><div><h3>Free & Open Source</h3><p>Free to use, no subscription or cookies, and available on GitHub.</p></div></article>
          <article class="reassurance-card"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m12 3-1.5 5.5L5 10l5.5 1.5L12 17l1.5-5.5L19 10l-5.5-1.5L12 3Z"/><path d="m19 16-.7 2.3L16 19l2.3.7L19 22l.7-2.3L22 19l-2.3-.7L19 16Z"/><path d="m5 3-.6 1.4L3 5l1.4.6L5 7l.6-1.4L7 5l-1.4-.6L5 3Z"/></svg><div><h3>Simple by Design</h3><p>Only the options you actually need. Use your own backgrounds.</p></div></article>
        </div>
        <footer class="footer"><span>by <a href="https://www.alexisg.net" target="_blank" rel="noopener noreferrer">alexisg</a></span><a href="https://github.com/agalbourdin/frameup" target="_blank" rel="noopener noreferrer">View FrameUp on GitHub</a></footer>
      </section>
    </main>
    <script src="../scripts/composer.ts"></script>
  </body>
</html>
