---
import "../styles/globals.css";

const presetBackgrounds = [
  "0_purple_grained.png", "blue.png", "blue_grained.png", "multicolor.png",
  "multicolor_grained.png", "orange_grained.png", "pink.png", "pink_grained.png",
  "purple.png", "yellow.png",
].map((filename) => ({
  src: `./preset-backgrounds/${filename}`,
  name: filename.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " "),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Compose a screenshot and background into a 1200 × 630 PNG in your browser." />
    <title>FrameUp | Screenshot composer</title>
    <link rel="icon" href="./favicon.ico" />
    <link rel="icon" href="./favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="./favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;200;300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="page-title"><h1 id="page-title">FrameUp</h1><p class="intro">Compose a 1200 × 630 px social visual.</p></section>
      <section class="workspace" aria-label="Visual creation">
        <div class="controls">
          <div class="background-source" aria-label="Background image source">
            <button type="button" class="active" data-background-mode="presets">Preset backgrounds</button>
            <button type="button" data-background-mode="upload">Upload background</button>
            <button type="button" data-background-mode="color">Color background</button>
          </div>
          <div class="background-panel" data-background-panel="presets"><div class="preset-grid" aria-label="Preset background images">
            {presetBackgrounds.map((preset, index) => <button type="button" class:list={["preset-card", { selected: index === 0 }]} data-preset-src={preset.src} data-preset-name={preset.name} aria-pressed={index === 0 ? "true" : "false"} aria-label={`Choose background ${preset.name}`}><img src={preset.src} alt="" /></button>)}
          </div></div>
          <div class="background-panel" data-background-panel="upload" hidden><label class="upload-card"><input id="background-upload" type="file" accept="image/png,image/jpeg,image/webp" /><span class="upload-icon" aria-hidden="true">✦</span><span class="upload-copy"><strong>Background image</strong><small id="background-file-name">PNG, JPEG, or WebP</small></span><span class="upload-action">Choose</span></label></div>
          <div class="background-panel" data-background-panel="color" hidden><fieldset class="color-background-control"><legend>Color background</legend><div class="color-style-options" aria-label="Color background style"><label><input type="radio" name="gradient-style" value="solid" checked /><span>Solid</span></label><label><input type="radio" name="gradient-style" value="horizontal" /><span>Horizontal</span></label><label><input type="radio" name="gradient-style" value="vertical" /><span>Vertical</span></label><label><input type="radio" name="gradient-style" value="radial" /><span>Radial</span></label></div><div class="color-pickers"><label><span id="primary-color-label">Color</span><input id="primary-color" type="color" value="#9b5de5" /><output id="primary-color-value">#9B5DE5</output></label><label id="secondary-color-control" hidden><span>Second color</span><input id="secondary-color" type="color" value="#f15bb5" /><output id="secondary-color-value">#F15BB5</output></label></div></fieldset></div>
          <label class="upload-card"><input id="screenshot-upload" type="file" accept="image/png,image/jpeg,image/webp" /><span class="upload-icon" aria-hidden="true">▣</span><span class="upload-copy"><strong>Screenshot</strong><small id="screenshot-file-name">PNG, JPEG, or WebP</small></span><span class="upload-action">Choose</span></label>
          <label class="shadow-option"><input id="shadow-toggle" type="checkbox" checked /><span>Add a shadow to the screenshot</span></label>
          <fieldset class="radius-control"><legend>Corner radius</legend><div class="radius-options"><label><input type="radio" name="corner-radius" value="0" /><span>No rounding</span></label><label><input type="radio" name="corner-radius" value="8" /><span>8 px</span></label><label><input type="radio" name="corner-radius" value="16" /><span>16 px</span></label><label><input type="radio" name="corner-radius" value="24" /><span>24 px</span></label><label><input type="radio" name="corner-radius" value="32" checked /><span>32 px</span></label></div></fieldset>
          <p class="status" id="status" aria-live="polite">Reading image…</p>
        </div>
        <div class="preview-panel"><div class="preview-topline"><span>PREVIEW</span><span>1200 × 630 PX</span></div><div class="canvas-wrap" id="canvas-wrap"><p>Your visual will appear here</p><canvas id="preview-canvas" aria-label="Preview of your composed visual"></canvas></div><button class="download-button" id="download-button" type="button" disabled>Download PNG <span aria-hidden="true">↓</span></button></div>
      </section>
      <section class="reassurance" aria-labelledby="reassurance-title">
        <div class="reassurance-heading"><h2 id="reassurance-title">PRIVATE BY DESIGN</h2></div>
        <div class="reassurance-grid">
          <article class="reassurance-card"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M8 9h8"/></svg><div><h3>Processed in your browser</h3><p>Your images are composed directly on your device.</p></div></article>
          <article class="reassurance-card"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 4.5 6.5V12c0 4.6 3.2 7.8 7.5 9 4.3-1.2 7.5-4.4 7.5-9V6.5L12 3Z"/><path d="m9.5 12 1.7 1.7 3.6-3.6"/></svg><div><h3>No uploads</h3><p>Your screenshot and background are never sent to a server.</p></div></article>
          <article class="reassurance-card"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 13h18M7 9h.01M7 16h.01M11 16h6"/></svg><div><h3>Nothing is stored</h3><p>FrameUp does not keep a copy of your files.</p></div></article>
          <article class="reassurance-card"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3"/><path d="M6.5 19a5.5 5.5 0 0 1 11 0"/></svg><div><h3>No account or cookies</h3><p>Create and download without signing up, and without cookies.</p></div></article>
        </div>
        <p class="byline">by <a href="https://www.alexisg.net" target="_blank" rel="noopener noreferrer">alexisg</a></p>
      </section>
    </main>
    <script src="../scripts/composer.ts"></script>
  </body>
</html>
